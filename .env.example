# Replace all example secrets before starting. Keep .env out of version control.
# Keep the password in DATABASE_URL equal to APP_DATABASE_PASSWORD when commands read this file directly.
DATABASE_URL=postgresql+asyncpg://quickdrop_app:replace-with-a-different-random-app-password@db:5432/quickdrop
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
APP_DATABASE_PASSWORD=replace-with-a-different-random-app-password
SEED_DATABASE_PASSWORD=replace-with-a-different-random-seed-password
SESSION_SECRET=replace-with-32-or-more-random-characters
WEBHOOK_TOKEN=replace-with-a-random-webhook-token
MOCKPAYSWIFT_API_KEY=replace-with-a-random-provider-token
MOCKPAYSWIFT_TEST_TOKEN=replace-with-a-random-fixture-token
MOCKPAYSWIFT_URL=http://mockpayswift:8001
MOCKPAYSWIFT_DATABASE_PATH=/data/mockpayswift.sqlite3
MOCKPAYSWIFT_TEST_MODE=true
QUICKDROP_TEST_MODE=true
DEMO_RIDER_PASSWORD=replace-with-a-strong-demo-password
DEMO_EMPLOYEE_PASSWORD=replace-with-a-different-strong-demo-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_MODE=offline

